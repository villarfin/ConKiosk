#!/bin/sh
# Run the ConKiosk displays from Labwc itself. This is more reliable than an
# XDG .desktop autostart entry on Raspberry Pi OS's rpd-labwc session.

/home/conkiosk/.local/bin/conkiosk-dual-display >/home/conkiosk/.cache/conkiosk-dual-display.log 2>&1 &

# Preserve normal display wake/sleep behavior outside active use.
swayidle -w timeout 600 'wlopm --off \*' resume 'wlopm --on \*' &
