<?xml version="1.0"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <touch deviceName="wch.cn TouchScreen (USB 3-1)" mapToOutput="HDMI-A-1" mouseEmulation="no"/>
  <windowRules>
    <windowRule identifier="conkiosk-kiosk">
      <fixedPosition>yes</fixedPosition>
      <action name="MoveTo" x="0" y="0" />
      <action name="ResizeTo" width="1920" height="1200" />
    </windowRule>
    <windowRule identifier="conkiosk-tv">
      <fixedPosition>yes</fixedPosition>
      <action name="MoveTo" x="1920" y="0" />
      <action name="ResizeTo" width="1920" height="1200" />
    </windowRule>
  </windowRules>
</openbox_config>
