# Never point this at the staging or production database.
DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@127.0.0.1:5432/conkiosk_test
JWT_SECRET_KEY=TEST_ONLY_REPLACE_WITH_A_RANDOM_SECRET
ENVIRONMENT=test
CORS_ORIGINS=http://localhost:8081
ALLOW_SEED_DATA=true

# Required before integration tests may run. This prevents an accidental reset.
RUN_INTEGRATION_TESTS=true
