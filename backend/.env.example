# Use a MongoDB account with a strong password in production.
MONGO_URL=mongodb://USERNAME:PASSWORD@127.0.0.1:27017/?authSource=admin
DB_NAME=conkiosk

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ENVIRONMENT=production

# Comma-separated kiosk/TV origins; do not use * in production.
CORS_ORIGINS=http://KIOSK_SERVER_IP,http://KIOSK_SERVER_IP:8081

# Keep false in production. It enables a destructive demo-data endpoint.
ALLOW_SEED_DATA=false
