# Use a PostgreSQL account with a strong password in production.
# URL-encode reserved characters in the username or password.
DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@127.0.0.1:5432/conkiosk

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ENVIRONMENT=production

# Pi LAN origin. Change this when the router/Pi address changes; do not use localhost for phones.
LAN_ORIGIN=http://192.168.0.2
# Additional trusted browser origins, comma-separated. LAN_ORIGIN and its Expo port 8081 are included automatically.
CORS_ORIGINS=http://conkiosk.local,http://localhost:8081

# Keep false in production. It enables a destructive demo-data endpoint.
ALLOW_SEED_DATA=false
# Optional school-specific privacy details, shown by the local Privacy Notice.
PRIVACY_INSTITUTION=
PRIVACY_CONTACT=
PRIVACY_RETENTION=
# Import an approved roster before enabling strict student-ID matching.
REQUIRE_STUDENT_ROSTER=false
# Additional fixed kiosk device IPs allowed to look up student details.
KIOSK_ALLOWED_IPS=127.0.0.1,::1
